# 在 server 目录复制为 .env，再填写自己的配置。不要提交真实密码和令牌。
PORT=8080
# 本地 HTTP 开发设为 false；生产 HTTPS 部署设为 true，默认也是 true。
COOKIE_SECURE=false
MYSQL_DSN=your_user:your_password@tcp(127.0.0.1:3306)/my_exp?charset=utf8mb4&parseTime=True&loc=Local&timeout=5s
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
WECHAT_CALLBACK_TOKEN=replace_with_your_wechat_token
# 首次登录前填写自己的微信 OpenID，匹配的新用户注册为 admin，其余为 user。
ADMIN_OPENID=
# 自行设置随机密钥；缺少此项时服务启动失败。
JWT_SECRET=
# 图片上传可选，三项都填写后才启用；留空则不影响服务启动。
R2_ACCOUNT_ID=
R2_API_TOKEN=
R2_BUCKET_NAME=
# 可选：显式指定 demo 源码根目录（如 /var/www/my-exp/source/playground）；留空时自动兼容服务器 ./source 与本地 .. 目录结构。
DEMO_SOURCE_ROOT=

# 默认写入 server/logs/app.log；服务器建议设置绝对路径，例如 /var/log/zhiye。
LOG_DIR=logs
# 文件和控制台统一格式；本地需要易读文本时设为 text。
LOG_FORMAT=json
LOG_LEVEL=INFO
# 当前文件最多 100 MB；备份最多保留 14 天和 100 个，先达到限制的先清理。
LOG_MAX_SIZE_MB=100
LOG_MAX_AGE_DAYS=14
LOG_MAX_BACKUPS=100
# 超过这个毫秒数的数据库查询记为慢查询；失败查询由请求边界的业务日志记录。
LOG_SLOW_QUERY_MS=500
LOG_COMPRESS=true
# 每天上海时间零点切割，没有请求时也触发备份清理。
LOG_ROTATE_DAILY=true
LOG_TIMEZONE=Asia/Shanghai
# 本地同步输出控制台；生产只需要文件时设为 false。
LOG_CONSOLE=true
