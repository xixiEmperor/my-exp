# 前端依赖与构建结果不进入源码仓库。
web/node_modules/
web/dist/
web/.vite/
# workspace 根目录和各示例的依赖、构建缓存不提交。
**/node_modules/
**/dist/
**/.vite/
*.tsbuildinfo

# 后端可执行文件与本地运行日志不提交。
server/bin/
server/*.exe
# 服务器本地编译的产物和回滚文件不进入源码仓库。
server/my-exp
server/my-exp.new
server/my-exp.bak
server/my-exp.rollback
# Air 热更新生成的临时文件不进入源码仓库。
server/tmp/
*.log
# 包括压缩备份在内的本地日志目录不进入源码仓库。
server/logs/

# 本地环境变量保留在开发机器，只提交示例配置。
**/.env
**/.env.*
!**/.env.example

# 忽略常见的系统缓存文件。
.DS_Store
Thumbs.db

docs/
draw/
.multimodal-ppt-build

dump.rdb
